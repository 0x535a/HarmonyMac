+/*
+ * Dynamic BOs can use another VA if the kernel still owns a previous
+ * mapping at the first address. Hold each rejected reservation through this
+ * attempt so the VMA allocator cannot immediately choose it again. Never
+ * issue UNBIND for a conflicting address, whose mapping we do not own.
+ */
+static bool
+agx_bind_bo_with_new_va(struct agx_device *dev, struct agx_bo *bo,
+                       uint64_t va_size, enum agx_va_flags va_flags,
+                       uint32_t bind_flags, const char *origin)
+{
+   const int entry_errno = errno;
+   static int policy_logged;
+   if (!dev->is_virtio && debug_get_option_aurora_asahi_va_trace() &&
+       !p_atomic_cmpxchg(&policy_logged, 0, 1)) {
+      fprintf(stderr, "AURORA_ASAHI_VA_POLICY mono_ns=%" PRId64
+              " fd=%d vm=%u recycle_after_gem_close=1 collision_retries=%u\n",
+              os_time_get_nano(), dev->fd, dev->vm_id, AGX_VA_COLLISION_RETRIES);
+   }
+
+   struct agx_va *rejected[AGX_VA_COLLISION_RETRIES];
+   unsigned count = 0;
+   int error = 0;
+   uint64_t collision = 0;
+   for (;;) {
+      bo->va = agx_va_alloc(dev, va_size, bo->align, va_flags, 0);
+      if (!bo->va) {
+         error = ENOMEM;
+         break;
+      }
+      errno = 0;
+      if (!agx_bo_bind(dev, bo, bo->va->addr, bo->size, 0, bind_flags)) {
+         error = 0;
+         break;
+      }
+
+      error = errno ? errno : EIO;
+      if (dev->is_virtio || error != EALREADY)
+         break;
+      if (!count)
+         collision = bo->va->addr;
+      if (count == ARRAY_SIZE(rejected))
+         break;
+      rejected[count++] = bo->va;
+   }
+
+   for (unsigned i = 0; i < count; ++i)
+      agx_va_free(dev, rejected[i], false);
+
+   if (collision && agx_va_trace_error()) {
+      fprintf(stderr, "AURORA_ASAHI_VA_REBIND mono_ns=%" PRId64
+              " fd=%d vm=%u origin=%s handle=%u size=%#" PRIx64
+              " conflict=%#" PRIx64 " final_va=%#" PRIx64
+              " retries=%u result=%s errno=%d\n",
+              os_time_get_nano(), dev->fd, dev->vm_id, origin, bo->uapi_handle,
+              (uint64_t)bo->size, collision, bo->va ? bo->va->addr : UINT64_C(0),
+              count, error ? "failed" : "recovered", error);
+   }
+   errno = error ? error : entry_errno;
+   return !error;
 }
 
