+/* Opt-in bounded snapshots of the real softpipe state. No wrapper objects,
+ * resource references or diagnostic worker threads are introduced. */
+#ifdef __linux__
+#include <stdio.h>
+#include <unistd.h>
+#include "util/os_time.h"
+#include "util/u_debug.h"
