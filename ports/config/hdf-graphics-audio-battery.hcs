// Local development candidate. Preserve existing host indices and identities.
root {
    module = "hdf";
    device_info {
        match_attr = "hdf_manager";
        allocator {
            hostName = "allocator_host";
            priority = 50;
            uid = "root";
            gid = ["root"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH"];
            allocator_device {
                device0 {
                    policy = 2; priority = 100;
                    moduleName = "liballocator_driver_1.0.z.so";
                    serviceName = "allocator_service";
                    preload = 0; permission = 0x1b0; deviceMatchAttr = "";
                }
            }
        }
        composer {
            hostName = "composer_host";
            priority = 60;
            uid = "root";
            gid = ["root"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH"];
            composer_device {
                device0 {
                    policy = 2; priority = 100;
                    moduleName = "libdisplay_composer_driver_1.0.z.so";
                    serviceName = "display_composer_service";
                    preload = 0; permission = 0x1b0; deviceMatchAttr = "";
                }
            }
        }
        audio {
            hostName = "audio_host";
            priority = 70;
            uid = "audio_host";
            gid = ["audio_host", "audio", "system"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH", "SYS_NICE"];
            audio_primary_device {
                device0 {
                    policy = 2; priority = 100;
                    moduleName = "libaudio_primary_driver.z.so";
                    serviceName = "audio_manager_service";
                    preload = 0; permission = 0x1b4; deviceMatchAttr = "";
                }
            }
        }
        // Original power-host UID/groups/caps/domain. Only Battery HDI is
        // loaded here; suspend and charger-control services remain separate.
        power {
            hostName = "power_host";
            priority = 50;
            uid = "power_host";
            gid = ["power_host", "system", "log", "oeminfo_nvme_server", "battery_extra_host"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH", "BLOCK_SUSPEND", "SYS_ADMIN"];
            battery_device {
                device0 {
                    policy = 2; priority = 100;
                    moduleName = "libbattery_driver.z.so";
                    serviceName = "battery_interface_service";
                    preload = 0; permission = 0x1b4; deviceMatchAttr = "";
                }
            }
        }
    }
}
