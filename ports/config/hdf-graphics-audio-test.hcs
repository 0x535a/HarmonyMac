// Virtual graphics integration: independent allocator and composer hosts.
root {
    module = "hdf";
    device_info {
        match_attr = "hdf_manager";
        allocator {
            hostName = "allocator_host";
            priority = 50;
            uid = "root";
            gid = ["root"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH"];
            allocator_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "liballocator_driver_1.0.z.so";
                    serviceName = "allocator_service";
                    preload = 0;
                    permission = 0x1b0;
                    deviceMatchAttr = "";
                }
            }
        }
        composer {
            hostName = "composer_host";
            priority = 60;
            uid = "root";
            gid = ["root"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH"];
            composer_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "libdisplay_composer_driver_1.0.z.so";
                    serviceName = "display_composer_service";
                    preload = 0;
                    permission = 0x1b0;
                    deviceMatchAttr = "";
                }
            }
        }
        // Stock primary audio driver, required by AudioPolicy initialization.
        audio {
            hostName = "audio_host";
            priority = 70;
            uid = "audio_host";
            gid = ["audio_host", "audio", "system"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH", "SYS_NICE"];
            audio_primary_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "libaudio_primary_driver.z.so";
                    serviceName = "audio_manager_service";
                    preload = 0;
                    permission = 0x1b4;
                    deviceMatchAttr = "";
                }
            }
        }
    }
}
